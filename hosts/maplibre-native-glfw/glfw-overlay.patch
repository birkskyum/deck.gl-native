diff --git a/platform/glfw/CMakeLists.txt b/platform/glfw/CMakeLists.txt
index 68a1328a53ba..af29ad8ca04a 100644
--- a/platform/glfw/CMakeLists.txt
+++ b/platform/glfw/CMakeLists.txt
@@ -76,6 +76,33 @@ if(MLN_WITH_METAL)
     )
 endif()
 
+option(MLN_DECKGL_OVERLAY "Draw a deck.gl-native overlay in the GLFW app (Metal backend only)" OFF)
+if(MLN_DECKGL_OVERLAY)
