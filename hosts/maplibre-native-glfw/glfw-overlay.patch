diff --git a/platform/glfw/metal_backend.mm b/platform/glfw/metal_backend.mm
index 0497b558d652..741c87e307d2 100644
--- a/platform/glfw/metal_backend.mm
+++ b/platform/glfw/metal_backend.mm
@@ -6,6 +6,10 @@
 #include <Metal/Metal.hpp>
 #include <QuartzCore/CAMetalLayer.hpp>
 
+#ifdef MLN_DECKGL_OVERLAY
+#include "deckgl_overlay.hpp"
+#endif
+
 namespace mln {
 
 using namespace mtl;
@@ -63,6 +67,13 @@ public:
       if (auto* depthTarget = renderPassDescriptor->depthAttachment()) {
         depthTarget->setTexture(
             static_cast<mtl::Texture2D*>(depthTexture.get())->getMetalTexture());
+#ifdef MLN_DECKGL_OVERLAY
+        // deck.gl depth tests against this buffer after the map's pass, so it must start
+        // cleared and be written back to memory instead of discarded from tile memory.
+        depthTarget->setLoadAction(MTL::LoadActionClear);
+        depthTarget->setClearDepth(1.0);
+        depthTarget->setStoreAction(MTL::StoreActionStore);
+#endif
       }
     }
     if (stencilTexture) {
@@ -75,8 +86,27 @@ public:
   }
 
   void swap() override {
+#ifdef MLN_DECKGL_OVERLAY
+    // Commit the map frame, let deck.gl draw into the same attachments on the same queue,
+    // then present from a third command buffer so ordering follows commit order.
+    commandBuffer->commit();
+    if (deckgl_overlay::enabled()) {
+      auto* depth = depthTexture ? static_cast<mtl::Texture2D*>(depthTexture.get())->getMetalTexture() : nullptr;
+      const auto drawableSize = swapchain->drawableSize();
+      deckgl_overlay::render(rendererBackend.getDevice().get(),
+                             commandQueue.get(),
+                             surface->texture(),
+                             depth,
+                             static_cast<uint32_t>(drawableSize.width),
+                             static_cast<uint32_t>(drawableSize.height));
+    }
+    auto presentBuffer = NS::TransferPtr(commandQueue->commandBuffer());
+    presentBuffer->presentDrawable(surface.get());
+    presentBuffer->commit();
+#else
     commandBuffer->presentDrawable(surface.get());
     commandBuffer->commit();
+#endif
     commandBuffer.reset();
     renderPassDescriptor.reset();
   }
