+    )
+    target_include_directories(mbgl-glfw PRIVATE ${DECKGL_FFI_INCLUDE})
+    target_compile_definitions(mbgl-glfw PRIVATE MLN_DECKGL_OVERLAY=1)
+    target_link_libraries(
+        mbgl-glfw
+        PRIVATE
+        ${DECKGL_FFI_LIB}
+        "-framework Metal"
+        "-framework QuartzCore"
+        "-framework CoreGraphics"
+        "-framework Foundation"
+    )
+endif()
+
 if(MLN_WITH_WEBGPU)
