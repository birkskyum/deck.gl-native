+        message(FATAL_ERROR "MLN_DECKGL_OVERLAY requires MLN_WITH_METAL")
+    endif()
+    if(NOT DECKGL_FFI_LIB OR NOT DECKGL_FFI_INCLUDE)
+        message(FATAL_ERROR "MLN_DECKGL_OVERLAY requires DECKGL_FFI_LIB (path to libdeckgl.a) and DECKGL_FFI_INCLUDE (directory containing deckgl.h)")
